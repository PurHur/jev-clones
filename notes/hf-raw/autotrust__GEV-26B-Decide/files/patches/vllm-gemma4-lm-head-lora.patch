Subject: [PATCH 2/2] [LoRA] Dedupe aliased modules at activation (backport of
 vllm-project/vllm#39816; fixes Gemma-4 LoRA silently reset)

---
 vllm/lora/model_manager.py | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/vllm/lora/model_manager.py b/vllm/lora/model_manager.py
index d19bf31..8804dcb 100644
--- a/vllm/lora/model_manager.py
+++ b/vllm/lora/model_manager.py
@@ -336,8 +336,21 @@ class LoRAModelManager:
             "Activating LoRA. int id: %d, slot index: %d", lora_model.id, index
         )
         self.lora_index_to_id[index] = lora_model.id
+        # Aliased module paths (e.g. Gemma-4 `model.layers.N` and
+        # `model.self_decoder.decoder_layers.N`) point to the same physical LoRA
+        # wrapper: pick one entry per physical module, preferring the path that has
+        # weights, so a later alias cannot reset weights that were just loaded
+        # (upstream vllm-project/vllm#39816, fixes #39815).
+        chosen_modules: dict = {}
         for module_name, module in self.modules.items():
+            module_key = id(module)
             module_lora = self._get_lora_layer_weights(lora_model, module_name)
+            if module_key not in chosen_modules:
+                chosen_modules[module_key] = (module_name, module, module_lora)
+            elif module_lora is not None and chosen_modules[module_key][2] is None:
+                chosen_modules[module_key] = (module_name, module, module_lora)
+
+        for module_name, module, module_lora in chosen_modules.values():
             if not module_lora:
                 module.reset_lora(index)
