FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

WORKDIR /app
COPY --chown=10001:10001 server.py smoke_test.py markers_255.json /app/
USER 10001:10001
EXPOSE 30002
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=12 CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:30002/health', timeout=2).read()"]
ENTRYPOINT ["python3", "/app/server.py", "30002"]
